{
  "name": "portfolio",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "game:export": "node scripts/export-atlantis.mjs",
    "build": "next build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "measure:js": "node scripts/measure-js.mjs out",
    "media:build": "node scripts/build-media.mjs",
    "favicon:build": "node scripts/build-favicon.mjs",
    "card:build": "node scripts/build-share-card.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "serve": "14.2.7",
    "sharp": "0.35.5",
    "typescript": "~6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
